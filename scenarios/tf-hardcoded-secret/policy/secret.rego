package main

import rego.v1

resources contains r if {
	some path, value
	walk(input.values.root_module, [path, value])
	some r in value.resources
}

versions := [v | some v in resources; v.type == "aws_secretsmanager_secret_version"]

passwords := [p | some p in resources; p.type == "random_password"]

deny contains "expected exactly one aws_secretsmanager_secret_version" if count(versions) != 1

secret := json.unmarshal(versions[0].values.secret_string)

deny contains "secret JSON must keep username \"orders\"" if secret.username != "orders"

deny contains "password is not generated by random_password" if {
	not generated
}

generated if {
	some p in passwords
	p.values.result == secret.password
}

deny contains msg if {
	some p in passwords
	p.values.result == secret.password
	p.values.length < 24
	msg := sprintf("random_password length %d, want at least 24", [p.values.length])
}
