package main_test

import data.main
import rego.v1

# Unit tests on hand-written state fixtures: `make policy-test`.

state(password, length) := {"values": {"root_module": {"resources": [
	{"type": "random_password", "values": {"result": "generated-value-0123456789abcdef", "length": length}},
	{"type": "aws_secretsmanager_secret_version", "values": {"secret_string": json.marshal({"username": "orders", "password": password})}},
]}}}

test_generated_password_passes if {
	count(main.deny) == 0 with input as state("generated-value-0123456789abcdef", 32)
}

test_literal_password_is_denied if {
	main.deny["password is not generated by random_password"] with input as state("typed-by-hand", 32)
}

test_short_password_is_denied if {
	main.deny["random_password length 12, want at least 24"] with input as state("generated-value-0123456789abcdef", 12)
}

test_renamed_user_is_denied if {
	renamed := {"values": {"root_module": {"resources": [
		{"type": "random_password", "values": {"result": "x", "length": 32}},
		{"type": "aws_secretsmanager_secret_version", "values": {"secret_string": json.marshal({"username": "admin", "password": "x"})}},
	]}}}
	main.deny["secret JSON must keep username \"orders\""] with input as renamed
}
