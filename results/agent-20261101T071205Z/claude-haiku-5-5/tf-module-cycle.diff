+  source_security_group_id = module.db.sg_id
+}
+
+resource "aws_security_group_rule" "db_from_app_postgres" {
+  type                     = "ingress"
+  description              = "Postgres from app"
+  from_port                = 5432
+  to_port                  = 5432
+  protocol                 = "tcp"
+  security_group_id        = module.db.sg_id
+  source_security_group_id = module.app.sg_id
 }
